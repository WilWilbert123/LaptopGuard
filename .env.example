# =====================================================================
# MY LAPTOP GUARD - Environment Configuration
# =====================================================================

# Server network binding (Default: 127.0.0.1 for local isolation)
HOST=127.0.0.1
PORT=3000

# Live network polling interval in milliseconds (Default: 3000ms / 3s)
POLL_INTERVAL_MS=3000

# Windows Defender telemetry poll interval in milliseconds (Default: 30000ms / 30s)
DEFENDER_POLL_INTERVAL_MS=30000

# Startup persistence inspection interval in milliseconds (Default: 60000ms / 1m)
STARTUP_POLL_INTERVAL_MS=60000

# Remote access and active session inspection interval in milliseconds (Default: 5000ms / 5s)
REMOTE_ACCESS_POLL_INTERVAL_MS=5000

# Security posture evaluation interval in milliseconds (Default: 300000ms / 5m)
POSTURE_POLL_INTERVAL_MS=300000

# Local database retention period in days (auto-pruned hourly)
RETENTION_DAYS=30

# Maximum SQLite database file size limit in megabytes before pruning low-severity events
MAX_DB_SIZE_MB=500

# Local authentication token for sensitive operations (firewall, scan, dismiss)
# If blank, an auto-generated token will be created and displayed in console on startup
API_AUTH_TOKEN=laptop-guard-local-token-change-me

# Windows Notification Toasts for High/Critical alerts (true | false)
ENABLE_DESKTOP_TOASTS=false
TOAST_MIN_SEVERITY=HIGH

# Emergency network isolation auto-restore duration in minutes (Default: 10)
AUTO_RESTORE_MINUTES=10

# Reconnect watch duration for blocked remote endpoints in hours (Default: 24)
RECONNECT_WATCH_HOURS=24

# Passive third-party network lookups (Reverse DNS / WHOIS / ASN)
# STRICT PRIVACY DEFAULT: false. Sending queries leaks remote IPs to external resolvers.
ENABLE_PASSIVE_NETWORK_LOOKUP=false

# Windows Service / Autostart tracking
AUTO_START_SERVICE=false

# Logging level: debug | info | warn | error
LOG_LEVEL=info

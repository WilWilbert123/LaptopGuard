<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>guardian.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Guardian-Setup</AssemblyName>
    <RootNamespace>GuardianInstaller</RootNamespace>
    <Product>Guardian Security Installer</Product>
    <Title>Guardian Setup Wizard</Title>
    <Description>Standalone Installer for Guardian Security</Description>
    <Version>1.0.0</Version>
    <Company>MIS-WILBERT</Company>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="guardian.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\dist\Guardian-Payload.zip">
      <LogicalName>GuardianPayload.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>